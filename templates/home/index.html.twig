{% extends 'base.html.twig' %}

{% block title %}
    {% if app.user %}Le Refuge - LPMDE{% else %}Accès Restreint{% endif %}
{% endblock %}

{% block body %}

    {# ========================================== #}
    {# CAS 1 : UTILISATEUR CONNECTÉ (Site visible) #}
    {# ========================================== #}
    {% if app.user %}
        
        <section class="relative h-[85vh] w-full overflow-hidden">
            <div class="absolute inset-0 bg-cover bg-center bg-no-repeat transition-transform duration-[10s] hover:scale-105"
                style="background-image: linear-gradient(to right, rgba(10,10,10,1) 0%, rgba(10,10,10,0.4) 50%, rgba(10,10,10,0.8) 100%), url('https://lh3.googleusercontent.com/aida-public/AB6AXuCLUqEwmO5EYFA4I0w4uTI5wYAaHpLcSkoCRM6emiWnW1rfKayolpaOTEowtIy5yrpIT92yhkTG3LOAFa8BGgIi9lMfBJWHj2962cA7JrfDytGPh0c5GsSUbwcRtXhWJKbXnQdYvwGauXPBsDlrWRRExepuxSLJUcxVFs64tFyUlMyBBwsdYrf4pJR3BohsuNpMbpOoe7e5M2vCQN89blxiInnUydwQDyJnKQ3YPMVF7H66pMYx60hZlEvvBn2QuMY-00IAHVAtxzY');">
            </div>
            <div class="relative z-10 max-w-[1200px] mx-auto px-4 lg:px-10 h-full flex flex-col justify-center items-start">
                <div class="max-w-2xl space-y-6">
                    <span class="inline-block px-3 py-1 bg-green-900/40 text-green-400 border border-green-500/30 text-[10px] font-bold uppercase tracking-widest rounded animate-pulse">
                        ● Access Granted
                    </span>
                    <h1 class="text-6xl lg:text-8xl font-black uppercase leading-[0.9] tracking-tighter">
                        <span class="text-white">Welcome to</span> <br />
                        <span class="text-primary italic">The Vault</span>
                    </h1>
                    <p class="text-lg lg:text-xl text-slate-300 font-light max-w-lg leading-relaxed">
                        The collection is open. Browse the cursed artifacts before the moon sets.
                    </p>
                    <div class="flex flex-wrap gap-4 pt-4">
                        <button class="bg-primary hover:bg-primary/90 text-white font-bold py-4 px-10 rounded-lg flex items-center gap-2 transition-all uppercase text-sm tracking-widest group">
                            Explore Collection
                            <span class="material-symbols-outlined group-hover:translate-x-1 transition-transform">arrow_downward</span>
                        </button>
                    </div>
                </div>
            </div>
        </section>

        <main class="max-w-[1200px] mx-auto px-4 lg:px-10 py-20 space-y-24 animate-fade-in">
             <section>
                <div class="flex items-end justify-between mb-10">
                    <h2 class="text-3xl font-bold uppercase tracking-tighter text-white">Cursed Manifestations</h2>
                    <a class="text-primary text-xs font-bold uppercase tracking-widest flex items-center gap-2 hover:underline" href="#">
                        View All <span class="material-symbols-outlined text-sm">trending_flat</span>
                    </a>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
                    <div class="group relative aspect-[3/4] overflow-hidden rounded-xl bg-surface-dark border border-white/5">
                        <div class="absolute inset-0 bg-cover bg-center transition-transform duration-500 group-hover:scale-110" style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuA49dCZMpIScUinC8InBMl4dYsdsZ9UwWZtjoZIA98zmT4hXiPD6idzOXn4so0mVoxMITDGUW8T0ZQQVRdNWO-tkGjIXRC2QG7jfGcjfQVtnV5_Tn_BLJxeGi_p7caSi_NOeOreNtlGV91QZGy0iOb70lEtb8DX4yo2dLF7riuV9gszMwp9MvnTeJFRoc3-TfWKpFXijK30NdC9sOv1PpHYYkShE--uRfeVCHfbW-Ybj14i6_MjCBpT0VHkYfwIjGeINzmYAZXPQxA');"></div>
                        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity flex flex-col justify-end p-6">
                            <button class="w-full bg-primary text-white py-3 rounded-lg font-bold text-xs uppercase tracking-widest">Add to Crypt</button>
                        </div>
                    </div>
                     </div>
            </section>
        </main>

        <footer class="bg-surface-dark border-t border-white/5 mt-20 py-10 text-center text-slate-500 text-xs uppercase tracking-widest">
            © 2026 La Petite Maison de l'Épouvante.
        </footer>

    {# ========================================== #}
    {# CAS 2 : PAS CONNECTÉ (Porte Verrouillée)    #}
    {# ========================================== #}
    {% else %}

        <section class="h-screen w-full flex flex-col items-center justify-center relative overflow-hidden bg-black">
            <div class="absolute inset-0 bg-cover bg-center opacity-40" 
                 style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuCLUqEwmO5EYFA4I0w4uTI5wYAaHpLcSkoCRM6emiWnW1rfKayolpaOTEowtIy5yrpIT92yhkTG3LOAFa8BGgIi9lMfBJWHj2962cA7JrfDytGPh0c5GsSUbwcRtXhWJKbXnQdYvwGauXPBsDlrWRRExepuxSLJUcxVFs64tFyUlMyBBwsdYrf4pJR3BohsuNpMbpOoe7e5M2vCQN89blxiInnUydwQDyJnKQ3YPMVF7H66pMYx60hZlEvvBn2QuMY-00IAHVAtxzY'); filter: blur(8px);">
            </div>

            <div class="relative z-10 text-center max-w-2xl px-6 animate-fade-in">
                <div class="mb-8 flex justify-center">
                    <div class="w-20 h-20 rounded-full border-2 border-primary/30 bg-black/50 flex items-center justify-center shadow-[0_0_30px_rgba(220,38,38,0.2)]">
                        <span class="material-symbols-outlined text-4xl text-primary">lock</span>
                    </div>
                </div>

                <h1 class="text-5xl lg:text-7xl font-black uppercase tracking-tighter text-white mb-6">
                    Restricted <span class="text-primary">Area</span>
                </h1>
                
                <p class="text-xl text-slate-400 font-light mb-10 leading-relaxed">
                    Only initiated members may enter.
                </p>

                <a href="{{ path('app_login') }}" 
                   class="inline-flex items-center gap-3 bg-primary hover:bg-primary/90 text-white font-bold py-4 px-10 rounded-lg transition-all uppercase text-sm tracking-widest shadow-[0_0_20px_rgba(220,38,38,0.4)] hover:-translate-y-1">
                    <span class="material-symbols-outlined">vpn_key</span>
                    Access Login Portal
                </a>
            </div>
        </section>

    {% endif %}

{% endblock %}