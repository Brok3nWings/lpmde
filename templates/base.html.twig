{# templates/base.html.twig #}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>{% block title %}LPMDE{% endblock %}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" />
    <script src="https://cdn.tailwindcss.com"></script>
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: '#dc2626',      
                        'surface-dark': '#111827' 
                    },
                    animation: { 'fade-in': 'fadeIn 0.5s ease-out' },
                    keyframes: {
                        fadeIn: {
                            '0%': { opacity: '0', transform: 'translateY(-10px)' },
                            '100%': { opacity: '1', transform: 'translateY(0)' },
                        }
                    }
                }
            }
        }
    </script>
    <style>
        body { font-family: sans-serif; }
        .material-symbols-outlined { vertical-align: middle; }
    </style>
</head>

<body class="bg-black text-white font-sans antialiased">
    
    <div class="fixed top-6 right-6 z-50 flex flex-col items-center animate-fade-in">
        {% if app.user %}
            <div class="w-12 h-12 rounded-full bg-white/10 backdrop-blur-md border border-white/20 flex items-center justify-center shadow-lg mb-2">
                <span class="material-symbols-outlined text-white text-2xl">person</span>
            </div>
            <span class="text-white font-bold text-xs uppercase tracking-widest bg-black/60 px-3 py-1 rounded-full border border-white/5 shadow-sm mb-1">
                {{ app.user.email }}
            </span>
            <a href="{{ path('app_logout') }}" class="text-[10px] font-bold text-red-400 hover:text-red-300 uppercase tracking-[0.2em] transition-colors hover:underline">
                Se déconnecter
            </a>
        {% else %}
            <a href="{{ path('connect_keycloak_start') }}" class="group flex items-center gap-2 bg-primary/90 hover:bg-primary text-white px-6 py-3 rounded-lg font-bold text-xs uppercase tracking-widest backdrop-blur-md transition-all shadow-lg hover:shadow-red-900/50">
                <span class="material-symbols-outlined text-sm">login</span>
                Member Login
            </a>
        {% endif %}
    </div>

    {% block body %}{% endblock %}
    
</body>
</html>